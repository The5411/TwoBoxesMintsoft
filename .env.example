# --- Mintsoft (requeridas) ---
MINTSOFT_USERNAME=
MINTSOFT_PASSWORD=

# --- Webhook entrante (requerida) ---
WEBHOOK_SECRET=

# --- Google Apps Script ---
GAS_URL=
WEBHOOKS_URL=

# --- Alertas por mail ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
# Lista separada por comas. La leen services/mintsoft_service.py y mappers/mintsoft_mapper.py.
ALERT_EMAIL_TO=
# Ventana de agrupacion de alertas repetidas del mapper, en segundos (default 1800).
ALERT_THROTTLE_SECONDS=1800

# --- Comportamiento ---
# Tipos de evento que se procesan en Mintsoft. El resto se archiva pero no se escribe.
EVENT_TYPES=return-complete
# Estados de orden de Mintsoft que habilitan un return interno (4=DESPATCHED, 5=INVOICED, 6=INVOICEFAILED).
RETURNABLE_ORDER_STATUS_IDS=4,5,6
# Tamano maximo del cuerpo del webhook, en bytes.
MAX_CONTENT_LENGTH=5242880

# --- Runtime ---
PORT=8080
LOG_LEVEL=INFO
