# --- Mintsoft (requeridas) ---
MINTSOFT_USERNAME=
MINTSOFT_PASSWORD=

# --- Webhook entrante (requerida) ---
WEBHOOK_SECRET=

# --- Google Apps Script ---
GAS_URL=
WEBHOOKS_URL=

# --- Alertas por mail ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
# Lista separada por comas. La leen services/mintsoft_service.py y mappers/mintsoft_mapper.py.
ALERT_EMAIL_TO=
# Ventana de agrupacion de alertas repetidas del mapper, en segundos (default 1800).
ALERT_THROTTLE_SECONDS=1800

# --- Comportamiento ---
# Tipos de evento que se procesan en Mintsoft. El resto se archiva pero no se escribe.
EVENT_TYPES=return-complete
# Estados de orden de Mintsoft que habilitan un return interno (4=DESPATCHED, 5=INVOICED, 6=INVOICEFAILED).
RETURNABLE_ORDER_STATUS_IDS=4,5,6
# Tamano maximo del cuerpo del webhook, en bytes.
MAX_CONTENT_LENGTH=5242880

# --- Runtime ---
PORT=8080
LOG_LEVEL=INFO

# --- Persistencia e idempotencia (E-1 / OPS-01 / COR-07) ---
# Postgres: el unico backend que sobrevive a un deploy y que comparten varias
# instancias. Es el que corresponde en produccion. Sin esta variable el store
# usa SQLite en STORE_PATH, que comparte estado entre los workers del mismo
# contenedor pero se pierde en cada deploy (disco efimero).
DATABASE_URL=
STORE_PATH=webhook_events.db
# true (default): si la base no responde NO se escribe en Mintsoft. El evento se
# archiva y sale un mail. Ponerlo en false procesa a riesgo de duplicar returns.
REQUIRE_STORE=true
# Guardar el payload completo permite reprocesar desde la base. Incluye datos del
# comprador (nombre, mail, direccion del RMA).
PERSIST_PAYLOAD=true
# Un claim abierto mas de estos segundos se considera colgado y se puede retomar.
CLAIM_STALE_SECONDS=1800
# Que hacer con un evento NUEVO cuya Reference ya tiene un return: warn | block | off
DUPLICATE_REFERENCE_ACTION=warn

# --- Locations y reasons de Mintsoft ---
# Override JSON de las locations de returns por warehouse (3=Wholesale, 5=E-Comm).
# good = RET, quarantine = RET-TEMP. Por defecto:
#   {"3":{"good":4104,"quarantine":9},"5":{"good":4299,"quarantine":4304}}
RETURN_LOCATIONS=
# Nombres de las locations de origen del TransferStock.
SOURCE_LOCATION_GOOD=RET
SOURCE_LOCATION_QUARANTINE=RET-TEMP
# Dispositions de Two Boxes que vuelven a stock vendible (el resto va a cuarentena).
GOOD_STOCK_DISPOSITIONS=Return to Stock
MISSING_DISPOSITION=Missing
# ReturnReasonId de Mintsoft (1 = Good Stock, 2 = Quarantine).
RETURN_REASON_GOOD=1
RETURN_REASON_QUARANTINE=2
# Largo maximo de la Reference que acepta Mintsoft.
REFERENCE_MAX_LEN=50

# --- Pools de threads ---
# Separados a proposito: un Google Apps Script lento no debe demorar el WMS.
WORKERS_MINTSOFT=10
WORKERS_ARCHIVO=4
