# ---- Secrets / local config ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# ---- Python bytecode / caches ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/
# OJO: .python-version NO va acá. Es el pin de version del proyecto, no un
# artefacto de virtualenv: lo leen mise (que es lo que usa produccion) y el
# setup-python del CI. Estando ignorado, `git add .python-version` lo saltea en
# silencio y el workflow falla con "python-version-file not found".

# ---- Packaging / build ----
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ---- Test / coverage / type caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ---- Logs & runtime output ----
logs/
*.log

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- Notebooks ----
.ipynb_checkpoints/

# ---- Payloads reales de webhooks (traen PII de clientes) ----
jsonretry.json
*.payload.json

# ---- Herramientas de debug locales, no van al repo ----
